rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function userExists(uid) { return exists(/databases/$(database)/documents/users/$(uid)); }

    // ─────────────────────────────────────────────────────────
    // USERS: Core profile documents
    // ─────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // ─────────────────────────────────────────────────────────
    // FRIENDS: Bidirectional friend lists
    // ─────────────────────────────────────────────────────────
    match /friends/{uid}/list/{contactUid} {
      allow read:   if isOwner(uid);
      allow create: if isAuth() && (isOwner(uid) || request.auth.uid == contactUid);
      allow update: if isAuth() && (isOwner(uid) || request.auth.uid == contactUid);
      allow delete: if isAuth() && (isOwner(uid) || request.auth.uid == contactUid);
    }

    // ─────────────────────────────────────────────────────────
    // CONTACTS: Personal contact records
    // ─────────────────────────────────────────────────────────
    match /contacts/{uid}/list/{contactUid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // ─────────────────────────────────────────────────────────
    // CONVERSATIONS: Private & group chats
    // ─────────────────────────────────────────────────────────
    match /conversations/{convId} {
      allow read: if isAuth() && (
        !exists(/databases/$(database)/documents/conversations/$(convId)) ||
        request.auth.uid in resource.data.members ||
        request.auth.uid in resource.data.pendingMembers
      );
      allow create: if isAuth()
                    && request.auth.uid in request.resource.data.members;
      allow update: if isAuth()
                    && request.auth.uid in resource.data.members;
      allow delete: if false;

      // ───────────────────────────────────────────────────────
      // MESSAGES: Chat messages
      // ───────────────────────────────────────────────────────
      match /messages/{msgId} {
        allow read: if isAuth() && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(convId)
        ).data.members;
        
        allow create: if isAuth()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(convId)
          ).data.members
          && request.auth.uid == request.resource.data.senderId;
        
        allow update: if isAuth() && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(convId)
        ).data.members;
        
        allow delete: if false;
      }
    }

    // ─────────────────────────────────────────────────────────
    // NOTIFICATIONS: User notifications
    // ─────────────────────────────────────────────────────────
    match /notifications/{uid}/items/{notifId} {
      allow read:   if isOwner(uid);
      allow create: if isAuth();
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }
  }
}