{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".read":  "auth != null"
      }
    },
    "typing": {
      ".read": "auth != null",
      "$convId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".read":  "auth != null"
        }
      }
    }
  }
}